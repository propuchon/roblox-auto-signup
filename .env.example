# Setup answers for main.py. Copy to .env and edit.
# A key that is set (even to an empty value) answers its question without prompting.
# An empty value is the same as pressing Enter (the default). Delete or comment out a line to be asked in the terminal again.

# Browser executable path. Empty = system Chrome.
BROWSER_PATH=/Applications/Chromium.app/Contents/MacOS/Chromium

# Password for every account and its email. Empty = random password per account (recommended).
PASSWORD=

# Create a mail.tm email and verify it on the account? [y/n] Empty = no.
# "y" lets the account be recovered by email but adds a few steps per account; "n" skips both email creation and verification.
EMAIL_VERIFICATION=n

# Username prefix ("qing" gives qing_0, qing_1, ...). Empty = random names.
NAME_PREFIX=

# Only used when NAME_PREFIX is empty. Scrambled random usernames? [y/n] Empty = yes.
# "n" builds word-based names, which can take longer.
SCRAMBLED_USERNAME=y

# Randomize the avatar after signup? [y/n] Empty = yes.
CUSTOMIZATION=y

# Usernames to follow after signup, comma separated. Empty = none.
FOLLOW_USERS=

# Proxies, comma separated. Each entry may have its own username/password:
# PROXIES=user1:pass1@host1:8080,user2:pass2@host2:8080
# host:port and http://host:port also work. Percent-encode reserved characters
# in inline credentials (e.g. @ -> %40, comma -> %2C, # -> %23).
# Used in order, one proxy per signup attempt. Exact duplicates are removed.
# If no proxy works, the run stops. Empty PROXIES and PROXY_FILE = no proxy.
PROXIES=

# Optional text file: one proxy per line, using the same formats as PROXIES.
# Relative paths start at the project folder. Entries are appended to PROXIES.
PROXY_FILE=

# Shared login for entries WITHOUT inline credentials. Inline login takes priority.
PROXY_USERNAME=
PROXY_PASSWORD=

# Incognito mode? [y/n] Empty = yes. Disabled for proxies requiring authentication.
INCOGNITO=

# Number of accounts to create. Empty = 1. Over 100 still asks for confirmation.
ACCOUNT_COUNT=1

# Copy .ROBLOSECURITY cookies (account manager format) to the clipboard at the end? [y/n] Empty = no.
EXPORT_TO_CLIPBOARD=n
