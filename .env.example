# Shared configuration. Copy to .env. Values default without prompting.
# Shell environment variables override .env, including explicitly empty values.
# Empty password = random password for each attempt.
PASSWORD=
# Empty prefix = generated username. Prefixes get a random numeric suffix.
NAME_PREFIX=
SCRAMBLED_USERNAME=y
# Optional YYYY-MM-DD. Empty retains random birthdays from the previous script.
BIRTHDAY=
# Number of attempts, including failures; 0 = unlimited (default).
# An explicit CLI count takes precedence. Default mode is a visible browser.
ACCOUNT_COUNT=0

# Random pause in seconds before the next account; no pause after the last one.
# All ranges below use minimum,maximum: finite numbers, 0 <= minimum <= maximum.
# Decimals are allowed. Empty/unset ranges use the defaults shown below.
# Export results and close the browser before pausing. Ctrl+C stops the wait.
# After success: choose a fresh random delay of 30-45 seconds.
# Set 0,0 to disable a pause, or 30,30 for a fixed 30-second pause.
RANDOM_WHEN_DONE=30,45
# After failure, including unresolved CAPTCHA: choose 60-100 seconds.
# Continue only if attempts remain. Signup rate limits still stop the run.
RANDOM_WHEN_FAILED=60,100

# Terminal/browser only: choose a fresh 7-15 second timeout when CAPTCHA appears.
# Check for a login cookie about once per second; success ends the wait early.
# If unresolved at the deadline, mark failed, close, then apply RANDOM_WHEN_FAILED.
# 0,0 checks once without waiting; 15,15 uses a fixed 15-second timeout.
# HTTP mode does not use this wait and marks CAPTCHA failed immediately.
CAPTCHA_BEFORE_CLOSE=7,15

# Comma-separated proxies: [http://][username:password@]host:port.
# Inline credentials override shared defaults. Exact duplicates are removed.
PROXIES=
# Optional text file, one proxy per line, relative to this project directory.
PROXY_FILE=
PROXY_USERNAME=
PROXY_PASSWORD=

# HTTP mode only: User-Agent. Empty uses the built-in compatibility value.
HTTP_USER_AGENT=
# HTTP mode requests gzip; browsers negotiate their own compression.
# Terminal (headless) and browser (visible). Empty path enables auto-detection.
BROWSER_PATH=
INCOGNITO=n
# Authenticated browser proxies require a temporary extension; incognito is then
# disabled. Each account still uses a fresh temporary browser profile.
# Email/customization/following settings are no longer used.
